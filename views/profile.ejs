<!doctype html>
<html>
<head>
    <title>What's the Move?</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">

    <div class="page-header text-center">
        <h1><span class="fa fa-anchor"></span> What's the Move?</h1>
        <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    </div>

    <div class="row">

        <!-- LOCAL INFORMATION -->
        <!-- <div class="col-sm-6">
            <div class="well">
                <h3><span class="fa fa-user"></span> Local</h3>

                <% if (user.local.email) { %>
                    <p>
                        <strong>id</strong>: <%= user._id %><br>
                        <strong>email</strong>: <%= user.local.email %><br>
                        <strong>password</strong>: <%= user.local.password %>
                    </p>

                    <a href="/unlink/local" class="btn btn-default">Unlink</a>
                <% } else { %>
                    <a href="/connect/local" class="btn btn-default">Connect Local</a>
                <% } %>

            </div>
        </div> -->
        <div class="col-sm-6">
            <fieldset>
            <legend>What's the vibe tonight?</legend>

                 <div>
                 <input class="genreOption" type="checkbox" id="horror" name="genre" value="27" />
                 <label for="horror">Horror</label>
                 </div>

                 <div>
                 <input class="genreOption" type="checkbox" id="comedy" name="genre" value="35" />
                 <label for="comedy">Comedy</label>
                 </div>

                 <div>
                 <input class="genreOption" type="checkbox" id="drama" name="genre" value="18" />
                 <label for="drama">Drama</label>
                 </div>

                 <div>
                 <input class="genreOption" type="checkbox" id="action" name="genre" value="28" />
                 <label for="action">Action</label>
                 </div>

                 <div>
                 <input class="genreOption" type="checkbox" id="romance" name="genre" value="10749"/>
                 <label for="romance">Romance</label>
                 </div>

                <div>
                <button id="genrePicker" type="submit">Submit</button>
                </div>

            </fieldset>


        </div>
        <div class="col-sm-6">
          <h3>Show Inputs Here</h3>
          <ul class="messages">
          <% for(var i=0; i<messages.length; i++) {%>
            <li class="message">
              <span><%= messages[i].name %></span>
              <span><%= messages[i].msg %></span>
              <span><%= messages[i].thumbUp %></span>
              <span><i class="fa fa-thumbs-up" aria-hidden="true"></i></span>
              <span><i class="fa fa-thumbs-down" aria-hidden="true"></i></span>
              <span><i class="fa fa-trash" aria-hidden="true"></i></span>
            </li>
          <% } %>
          </ul>

          <h2>Add A Club</h2>
        <% if (user.local.email) { %>
          <form action="/messages" method="POST">
            <!-- <input type="text" value="<%= user.local.email %>" name="name"> -->
            <input type="text" placeholder="Club Name" name="msg">
            <input type="text" placeholder="Address" name="msg">
            <input type="text" placeholder="Open Mic Name" name="msg">
            <input type="text" placeholder="Open Mic Days" name="msg">
            <button type="submit">Submit</button>
          </form>
        </div>
        <% } %>

</div>

<script src="main.js"></script>

</body>
</html>
